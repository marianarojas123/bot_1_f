# Variables de entorno para PRODUCCIÓN en Hostinger
# IMPORTANTE: Cambiar estos valores en producción

# Configuración de Flask
FLASK_ENV=production
FLASK_APP=wsgi.py
SECRET_KEY=your-super-secret-production-key-change-this-immediately

# Base de datos MySQL en Hostinger
DATABASE_URL=mysql://username:password@localhost/database_name

# Configuración de seguridad
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Configuración de rate limiting
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_LOGIN=5 per 15 minutes

# Configuración de caché
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
